  "batch_size": 8,
  "learning_rate": 0.0005,
  "weight_decay": 0.0001,
  "dice_weight": 1.0,
  "torch_threads": 4,
  "math_threads": 1,
  "evaluation_workers": 3,
  "runtime": {"device": "auto"}
